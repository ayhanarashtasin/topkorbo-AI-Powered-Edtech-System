MONGODB_URI=mongodb://localhost:27017/topkorbo
PORT=5000
NODE_ENV=development
VITE_API_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
JWT_SECRET=replace-with-a-long-random-secret

# AI tutor (Groq — OpenAI-compatible). Get a key from https://console.groq.com/keys
# Either LLM_API_KEY or GROQ_API_KEY works — the controller accepts both.
LLM_API_KEY=
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Build the AI knowledge tree / mind map for reading books during processing.
# Costs extra LLM calls per chapter, so it is opt-in. Required for the reader's
# "Mind Map" feature to have data to display.
ENABLE_KNOWLEDGE_TREE=true

# ===== Community / Forum =====
# Optional Cloudinary configuration for forum image uploads.
# When ANY of the three are missing, uploads fall back to local disk
# at /uploads/forum/<userId>/<file> (served by the existing static handler).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin bootstrap — when the server starts, if it finds a user whose email
# matches ADMIN_EMAILS, that user's forumRole is upgraded to 'admin'.
ADMIN_EMAILS=admin@topkorbo.local
