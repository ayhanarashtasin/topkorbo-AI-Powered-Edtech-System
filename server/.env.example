MONGODB_URI=mongodb://localhost:27017/topkorbo
PORT=5000
NODE_ENV=development
VITE_API_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:5173
# Comma-separated list of additional browser origins allowed to call the API
# and connect via Socket.IO. In production, set this (and/or FRONTEND_URL) to
# your deployed frontend origin(s) to lock CORS down. Same-origin requests work
# without this value; other browser origins are denied by default.
CORS_ORIGINS=
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
JWT_SECRET=replace-with-a-long-random-secret

# AI tutor (Groq — OpenAI-compatible). Get a key from https://console.groq.com/keys
# Either LLM_API_KEY or GROQ_API_KEY works — the controller accepts both.
LLM_API_KEY=
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Build the AI knowledge tree / mind map for reading books during processing.
# Costs extra LLM calls per chapter, so it is opt-in. Required for the reader's
# "Mind Map" feature to have data to display.
ENABLE_KNOWLEDGE_TREE=true

# ===== Community / Forum =====
# Required on Vercel. Local development falls back to /uploads/forum when these
# values are absent, but Vercel's filesystem is not persistent.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required on Vercel for Socket.IO room coordination and distributed API rate
# limits across autoscaled backend instances.
REDIS_URL=

# Admin bootstrap — when the server starts, if it finds a user whose email
# matches ADMIN_EMAILS, that user's forumRole is upgraded to 'admin'.
ADMIN_EMAILS=admin@topkorbo.local

# ===== Payments (SSLCommerz) =====
# Sandbox credentials from https://developer.sslcommerz.com/registration/
# Keep SSLCZ_IS_LIVE=false for the sandbox.
SSLCZ_STORE_ID=your-sandbox-store-id
SSLCZ_STORE_PASSWORD=your-sandbox-store-password
SSLCZ_IS_LIVE=false
# Public base URL the gateway/browser can reach for payment callbacks.
# Defaults to the request host when unset (fine for local browser redirects;
# set a tunnel URL if you need server-to-server IPN to reach you).
SERVER_URL=http://localhost:5000
# Guest accounts are enabled by default for the current demo. Set these to false
# when the public demo period ends. Guest Admin grants administrator permissions.
ENABLE_GUEST_LOGIN=true
ENABLE_GUEST_ADMIN=true

# Forum migration only: set true after Atlas Performance Advisor confirms the
# reviewed legacy index allowlist is unused.
DROP_CONFIRMED_LEGACY_FORUM_INDEXES=false
REMOVE_LEGACY_FORUM_RELATIONS=false
